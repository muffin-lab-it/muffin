# 복사해서 .env.local 로 저장하고 값을 채우세요. .env.local 은 커밋되지 않습니다.
OPENAI_API_KEY=
# 비워두면 Easy/Standard 는 gpt-6-luna, Deep Dive 는 gpt-6-sol 을 사용합니다 (gpt-4.1 계열은 2027-01-14 종료).
OPENAI_MODEL=
OPENAI_MODEL_DEEP=
# 📋 분류 · ✂️ 정제가 쓰는 작은 모델. 비워두면 gpt-5.4-mini (응답 시간 때문에, OPENAI_MODEL 을 따르지 않음).
OPENAI_MODEL_SMALL=

# 프론트 개발용. 1 이면 OpenAI·tool 을 부르지 않고 샘플 리포트를 돌려줍니다 (키 불필요).
MUFFIN_MOCK=

# Supabase: 2단계 저장함 · 실행 로그 (docs/web-spec.md 4.3). 서버 전용이라 NEXT_PUBLIC_ 을 붙이지 않습니다. 값은 리더가 줍니다.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# 각 tool 이 쓰는 키. 발급 방법은 각 tool 폴더의 README.md 참고.
DATA_GO_KR_KEY=     # etf: 공공데이터포털 (금융위원회 증권상품시세정보)
ECOS_API_KEY=       # rate, macro: 한국은행 경제통계시스템
FRED_API_KEY=       # rate, macro: 미국 FRED
NEWS_API_KEY=       # news: 키가 필요한 소스를 쓸 때만
