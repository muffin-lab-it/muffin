# 복사해서 .env.local 로 저장하고 값을 채우세요. .env.local 은 커밋되지 않습니다.
OPENAI_API_KEY=
# 비워두면 Easy/Standard 는 gpt-6-luna, Deep Dive 는 gpt-6-sol 을 사용합니다 (gpt-4.1 계열은 2027-01-14 종료).
OPENAI_MODEL=
OPENAI_MODEL_DEEP=
# 📋 분류 · ✂️ 정제가 쓰는 작은 모델. 비워두면 gpt-5.4-mini (응답 시간 때문에, OPENAI_MODEL 을 따르지 않음).
OPENAI_MODEL_SMALL=

# 프론트 개발용. 1 이면 OpenAI·tool 을 부르지 않고 샘플 리포트를 돌려줍니다 (키 불필요).
MUFFIN_MOCK=

# Supabase: 2단계 저장함 · 실행 로그 (docs/web-spec.md 4.3). 서버 전용이라 NEXT_PUBLIC_ 을 붙이지 않습니다. 값은 리더가 줍니다.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# /admin(실행 로그) 로그인 비밀번호. 브라우저 기본 로그인 창에 넣습니다 (아이디는 아무거나). 비우면 /admin 은 404 입니다.
ADMIN_PASSWORD=

# 각 tool 이 쓰는 키. 발급 방법은 각 tool 폴더의 README.md 참고.
DATA_GO_KR_KEY=     # etf: 공공데이터포털 (금융위원회 증권상품시세정보)
ECOS_API_KEY=       # rate, macro: 한국은행 경제통계시스템
FRED_API_KEY=       # rate, macro: 미국 FRED
NEWS_API_KEY=       # news: 키가 필요한 소스를 쓸 때만

# 호출 제한 (#110, src/lib/ratelimit.ts). IP 는 원문 대신 sha256(ip + RATE_LIMIT_SALT) 앞 16자만 남깁니다.
# 값은 `openssl rand -hex 32` 로 만들어 Vercel(Production · Preview)과 같은 값을 넣고, 한 번 정하면 바꾸지 않습니다. 비우면 소금 없이 해시합니다.
RATE_LIMIT_SALT=
# 한도 (비우면 기본값): 사람당 10분 10회 · 하루 60회, IP 당 10분 30회. 팀 QA 기간에는 RATE_LIMIT_10M=20 권장.
RATE_LIMIT_10M=
RATE_LIMIT_DAY=
RATE_LIMIT_IP_10M=

# 리포트 API 를 부를 수 있는 출처 (src/lib/guard.ts). 비우면 운영 도메인 · Vercel 미리보기 · http://localhost:3000. 다른 포트로 띄우면 쉼표로 추가.
ALLOWED_ORIGINS=
